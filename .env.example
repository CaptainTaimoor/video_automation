# AI writing providers (the router uses the configured order and skips missing ones)
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
HF_API_KEY=
AI_GATEWAY_URL=
AI_GATEWAY_MODEL=
AI_GATEWAY_API_KEY=

# Licensed/free media providers
PEXELS_API_KEY=
PIXABAY_API_KEY=
STABLE_HORDE_KEY=
YT_ENABLE_STABLE_HORDE=0
YT_ENABLE_POLLINATIONS=0
YT_ENABLE_LOCAL_VISUAL_RELEVANCE=0
# Video encode: auto (prefer Intel QSV GPU) | qsv | nvenc | libx264
YT_VIDEO_ENCODER=auto

# Upload credentials. Keep real values only in .env/secrets, never in source.
UPLOAD_PROVIDER=youtube
YOUTUBE_API_KEY=
# GOOGLE_API_KEY=  # Optional alternate name for the same YouTube Data API key.
FB_APP_ID=
FB_APP_SECRET=
FB_USER_ACCESS_TOKEN=
FB_PAGE_TOKEN_ANCIENT_HISTORY=
FB_PAGE_TOKEN_BRAIN_LENS=

# Optional services
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
HEYGEN_EMAIL=
HEYGEN_PASSWORD=

# Phase D monetization (optional affiliate URLs — only used if set)
AFFILIATE_ANCIENT_BOOK_URL=
AFFILIATE_ANCIENT_TOOL_URL=
AFFILIATE_BRAIN_BOOK_URL=
AFFILIATE_BRAIN_TOOL_URL=

# Ready Queue + dashboard write lock (local LAN)
# Ready Queue defaults OFF via controls/flags/ready_queue.enabled
YT_READY_QUEUE=0
# Required for dashboard POST actions (toggle/force/cancel/settings). GET /api/status stays open.
YT_DASHBOARD_TOKEN=
YT_DASHBOARD_PORT=8787
YT_DASHBOARD_HOST=0.0.0.0
