# AI writing providers (the router uses the configured order and skips missing ones)
GEMINI_API_KEY=
# Independent free-tier routes. Leave a key blank to skip that route. Models
# deliberately live in environment variables so retiring/preview models never
# become a source-code deployment.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
OPENROUTER_API_KEY=
# Keep OpenRouter as the final text fallback only; its free router is dynamic.
OPENROUTER_MODEL=openrouter/free
HF_API_KEY=
AI_GATEWAY_URL=
AI_GATEWAY_MODEL=
AI_GATEWAY_API_KEY=

# Licensed/free media providers
PEXELS_API_KEY=
PIXABAY_API_KEY=
STABLE_HORDE_KEY=
YT_ENABLE_STABLE_HORDE=0
YT_ENABLE_POLLINATIONS=0
YT_ENABLE_LOCAL_VISUAL_RELEVANCE=0

# Quality-v2 rollout switches. Start in shadow mode; promote to enforcement
# only after importing history and reviewing a golden batch.
YT_QUALITY_V2=1
YT_QUALITY_V2_ENFORCE=0
YT_QUALITY_V2_DRAFTS=1

# Upload credentials. Keep real values only in .env/secrets, never in source.
UPLOAD_PROVIDER=youtube
YOUTUBE_API_KEY=
# GOOGLE_API_KEY=  # Optional alternate name for the same YouTube Data API key.
FB_APP_ID=
FB_APP_SECRET=
FB_USER_ACCESS_TOKEN=
FB_PAGE_TOKEN_ANCIENT_HISTORY=
FB_PAGE_TOKEN_BRAIN_LENS=

# Optional services
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
HEYGEN_EMAIL=
HEYGEN_PASSWORD=
